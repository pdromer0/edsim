{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "outputStyle": "Explanatory",
  "worktree": {
    "baseRef": "head"
  },
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Bash(uv sync)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(gh pr view *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh api repos/pdromer0/edsim/*)",
      "Bash(gh api -X POST repos/pdromer0/edsim/pulls *)",
      "Bash(gh api -X PATCH repos/pdromer0/edsim/pulls/*)",
      "Bash(gh project list *)",
      "Bash(gh project field-list *)",
      "Bash(gh project item-list *)",
      "Bash(gh project item-add *)",
      "Bash(gh project item-edit *)",
      "Bash(git fetch --prune)",
      "Bash(git fetch origin pull/*)",
      "Bash(git merge-base *)",
      "Bash(gh pr checks *)",
      "Bash(gh run view *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git pull *)",
      "Bash(gh pr create *)",
      "Bash(git push)",
      "Bash(git push origin feat/*)",
      "Bash(git push origin docs/*)",
      "Bash(git push -u origin feat/*)",
      "Bash(git push -u origin docs/*)",
      "Bash(git push origin chore/*)",
      "Bash(git push -u origin chore/*)",
      "Bash(git push origin fix/*)",
      "Bash(git push -u origin fix/*)",
      "Bash(git push origin refactor/*)",
      "Bash(git push -u origin refactor/*)",
      "Bash(git push origin test/*)",
      "Bash(git push -u origin test/*)",
      "Bash(git push origin ci/*)",
      "Bash(git push -u origin ci/*)",
      "Bash(scripts/tests-rapidos.sh*)",
      "Bash(scripts/tests-completos.sh*)",
      "Bash(scripts/tests-integracion.sh*)",
      "Bash(docker compose up *)",
      "Bash(docker compose down*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs *)",
      "Bash(uv sync --all-packages --extra kafka)",
      "Bash(git branch -D *)",
      "Bash(uv sync --offline --frozen --all-packages)",
      "Bash(uv run python -c 'import edsim; print(edsim.__file__)')"
    ],
    "ask": [
      "Edit(/config/**)",
      "Write(/config/**)",
      "Edit(/tests/data/**)",
      "Write(/tests/data/**)",
      "Bash(gh api repos/pdromer0/edsim/* -X*)",
      "Bash(gh api repos/pdromer0/edsim/* --method*)",
      "Bash(gh api repos/pdromer0/edsim/* -f*)",
      "Bash(gh api repos/pdromer0/edsim/* -F*)",
      "Bash(gh api repos/pdromer0/edsim/* --field*)",
      "Bash(gh api repos/pdromer0/edsim/* --raw-field*)",
      "Bash(gh api repos/pdromer0/edsim/* --input*)",
      "Bash(gh api -X * state=*)",
      "Bash(gh api -X * base=*)"
    ],
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(gh api *pulls/*/merge)",
      "Bash(gh api *pulls/*/merge *)",
      "Bash(gh api *edsim/merges*)",
      "Bash(gh api *-X DELETE*)",
      "Bash(gh api *-XDELETE*)",
      "Bash(gh api *--method DELETE*)",
      "Bash(gh api *--method=DELETE*)",
      "Bash(git push *--force*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "Bash(git push *+*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push * *:main*)",
      "Read(./.env)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "command -v jq >/dev/null 2>&1 || { echo 'ruff format (PostToolUse): jq no está instalado; no se formatea el fichero.' >&2; exit 1; }; jq -r '.tool_input.file_path' | grep '\\.py$' | xargs -r uv run ruff format"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/run-tests.sh",
            "statusMessage": "N2: tests rápidos con sello (scripts/tests-rapidos.sh); solo las suites afectadas, 2-3 min"
          }
        ]
      }
    ]
  }
}
