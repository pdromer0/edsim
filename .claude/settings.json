{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "outputStyle": "Explanatory",
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Bash(uv sync)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh run view *)",
      "Bash(git switch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git pull *)",
      "Bash(gh pr create *)",
      "Bash(git push)",
      "Bash(git push origin feat/*)",
      "Bash(git push origin docs/*)",
      "Bash(git push -u origin feat/*)",
      "Bash(git push -u origin docs/*)",
      "Bash(git push origin chore/*)",
      "Bash(git push -u origin chore/*)",
      "Bash(git push origin fix/*)",
      "Bash(git push -u origin fix/*)",
      "Bash(git push origin refactor/*)",
      "Bash(git push -u origin refactor/*)",
      "Bash(git push origin test/*)",
      "Bash(git push -u origin test/*)",
      "Bash(git push origin ci/*)",
      "Bash(git push -u origin ci/*)",
      "Bash(scripts/tests-rapidos.sh*)",
      "Bash(scripts/tests-completos.sh*)",
      "Bash(scripts/tests-integracion.sh*)",
      "Bash(docker compose up *)",
      "Bash(docker compose down*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs *)",
      "Bash(uv sync --all-packages --extra kafka)",
      "Bash(git branch -D *)"
    ],
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(git push *--force*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "Bash(git push *+*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push * *:main*)",
      "Read(./.env)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path' | grep '\\.py$' | xargs -r uv run ruff format"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/run-tests.sh"
          }
        ]
      }
    ]
  }
}
